# Template for local secrets. Copy to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is gitignored and loaded automatically by config.py. In CI, set these
# as real environment variables instead — no `.env` file is needed there, and
# real env vars take precedence over `.env` if both are present.
#
# NOTE: comments must be on their OWN line (a full-line `#`). Inline comments
# after a value are NOT stripped — `KEY=0   # note` makes the value "0   # note".
# Keep notes above the key, like below.

# CurseForge author Upload API token — https://legacy.curseforge.com/account/api-tokens
CURSEFORGE_API_TOKEN=your-curseforge-api-token-here
# Your addon's numeric project id, shown on its CurseForge project page
CURSEFORGE_PROJECT_ID=0
